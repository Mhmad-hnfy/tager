// This is your Prisma schema file
// SQLite does not support enums - using String with validation in app layer

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// UserRole: ADMIN | WHOLESALE | RETAIL
// UserStatus: ACTIVE | INACTIVE | PENDING
// OrderStatus: NEW | PROCESSING | ACCEPTED | REJECTED | READY | COMPLETED
// NotificationType: ORDER_NEW | ORDER_STATUS_CHANGED | SYSTEM

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  phone     String   @unique
  password  String
  role      String   @default("RETAIL")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wholesaleProfile WholesaleProfile?
  retailProfile    RetailProfile?
  notifications    Notification[]

  @@map("users")
}

model WholesaleProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  companyName String
  ownerName   String
  phone       String
  wilayaId    String?
  communeId   String?
  address     String?
  description String?
  logo        String?
  mapUrl      String?
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  wilaya            Wilaya?            @relation(fields: [wilayaId], references: [id])
  commune           Commune?           @relation(fields: [communeId], references: [id])
  products          Product[]
  categories        Category[]
  orders            Order[]
  deliverySchedules DeliverySchedule[]

  @@map("wholesale_profiles")
}

model RetailProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  shopName    String
  ownerName   String
  phone       String
  wilayaId    String?
  communeId   String?
  address     String?
  description String?
  mapUrl      String?
  zoneName    String?  // اسم منطقة التاجر للتوصيل
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wilaya  Wilaya?  @relation(fields: [wilayaId], references: [id])
  commune Commune? @relation(fields: [communeId], references: [id])
  orders  Order[]

  @@map("retail_profiles")
}

model Wilaya {
  id     String @id @default(cuid())
  nameAr String
  nameFr String
  code   String @unique

  communes          Commune[]
  wholesaleProfiles WholesaleProfile[]
  retailProfiles    RetailProfile[]
  deliverySchedules DeliverySchedule[]

  @@map("wilayas")
}

model Commune {
  id       String @id @default(cuid())
  nameAr   String
  nameFr   String
  wilayaId String

  wilaya            Wilaya             @relation(fields: [wilayaId], references: [id], onDelete: Cascade)
  wholesaleProfiles WholesaleProfile[]
  retailProfiles    RetailProfile[]

  @@map("communes")
}

model Category {
  id          String   @id @default(cuid())
  nameAr      String
  nameFr      String?
  icon        String?
  wholesaleId String?
  isGlobal    Boolean  @default(false)
  parentId    String?  // للأقسام الفرعية (الفروع)
  createdAt   DateTime @default(now())

  wholesale WholesaleProfile? @relation(fields: [wholesaleId], references: [id], onDelete: Cascade)
  products  Product[]
  parent    Category?          @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[]         @relation("CategoryChildren")

  @@map("categories")
}

model Product {
  id          String   @id @default(cuid())
  nameAr      String
  nameFr      String?
  description String?
  price       Float
  quantity    Int      @default(0)
  isAvailable Boolean  @default(true)
  isHidden    Boolean  @default(false)
  images      String   @default("[]")
  categoryId  String?
  wholesaleId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category   Category?        @relation(fields: [categoryId], references: [id])
  wholesale  WholesaleProfile @relation(fields: [wholesaleId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@map("products")
}

model Order {
  id          String   @id @default(cuid())
  retailId    String
  wholesaleId String
  status      String   @default("NEW")
  total       Float
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  retail    RetailProfile    @relation(fields: [retailId], references: [id], onDelete: Cascade)
  wholesale WholesaleProfile @relation(fields: [wholesaleId], references: [id], onDelete: Cascade)
  items     OrderItem[]

  @@map("orders")
}

model DeliverySchedule {
  id           String   @id @default(cuid())
  wholesaleId  String
  dayOfWeek    Int
  dayNameAr    String
  wilayaId     String?
  zoneName     String
  communeNames String?
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  wholesale WholesaleProfile @relation(fields: [wholesaleId], references: [id], onDelete: Cascade)
  wilaya    Wilaya?          @relation(fields: [wilayaId], references: [id])

  @@map("delivery_schedules")
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  titleAr   String
  titleFr   String?
  messageAr String
  messageFr String?
  type      String   @default("SYSTEM")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model SiteSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}
